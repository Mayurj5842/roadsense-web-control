# Firebase Web app config (public client config; still protect writes with database rules)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Device to monitor. UI reads /devices/{deviceId}/events and /devices/{deviceId}/status
VITE_DEVICE_ID=ESP32-PUNE-01

# Optional database root paths (the device ID segment is added by the app)
VITE_FIREBASE_EVENTS_PATH=devices
VITE_FIREBASE_STATUS_PATH=devices
